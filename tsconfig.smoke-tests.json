{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2020",
    "outDir": ".smoke-dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "noEmit": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "tests/**/*.ts",
    "store/schedule.ts",
    "store/savedWorkouts.ts",
    "store/exerciseCatalog.ts",
    "data/seededCatalog.ts",
    "vendor/free-exercise-db/exercises.json"
  ]
}
